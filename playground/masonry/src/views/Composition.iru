<view>
    <Box class="stack">
        <DemoPanel title="Props, emitted events and computed state">
            <Counter label="First counter" :count={first.count.get()} :doubled={first.doubled.get().unwrap_or_default()} @increment={increment_first} />
            <Counter label="Second counter" :count={second.count.get()} :doubled={second.doubled.get().unwrap_or_default()} @increment={increment_second} />
            <NameInput model:value={name} @update:value={mark_dirty} @confirmed={confirm_name} />
            <Text :text={message.clone()} class="muted" />
        </DemoPanel>
        <DemoPanel title="Retained children and provide / inject">
            <Row :style={Style::new().wrap(true)} gap={8.0}>
                <Button text="Reverse rows" @click={reverse_rows} class="button" />
                <Button text="Remove first" @click={remove_row} :disabled={rows.is_empty()} class="button" />
                <Button text="Restore rows" @click={restore_rows} class="button" />
            </Row>
            <Box :style={injected_style(scope)}>
                <For each={rows.iter()} item="row" key={row}>
                    <RetainedCounter :label={format!("Row {row}")} />
                </For>
            </Box>
        </DemoPanel>
    </Box>
</view>
<rust>
use crate::components::{
    counter as Counter, demo_panel as DemoPanel, name_input as NameInput,
    retained_counter as RetainedCounter,
};
use crate::composables::use_counter::{Counter as CounterState, use_counter};
use crate::features::composition::{
    confirm_name, increment_first, increment_second, injected_style, mark_dirty, remove_row,
    restore_rows, reverse_rows,
};
use inrux::Style;
#[derive(Clone)]
pub struct Props {}

let name: String = "Inrux Workspace".into();
let saved: bool = true;
let message: String = "Edit the custom model, then confirm its typed payload.".into();
let first: CounterState = use_counter();
let second: CounterState = use_counter();
let rows: Vec<u32> = vec![1, 2];
</rust>
