<view>
    <Column gap={28.0}>
        <Text text="Demos" class="section-title" />
        <DemoPanel title="Live preview">
            <Row class="preview-toolbar" :style={Style::new().wrap(true)}>
                <Text text="Interactive example" class="code-header" />
                <Spacer />
                <Button text="Reset example" @click={crate::catalogue::reset} class="button" />
            </Row>
            <Column class="preview-stage">
                <Component :is={crate::catalogue::preview(state, events)} />
            </Column>
        </DemoPanel>
        <Text text="Usage" class="section-title" />
        <Column class="code-surface">
            <Text text="Usage in .iru" class="code-header" />
            <Markdown :document={usage.clone()} />
        </Column>
        <Column id="appearance">
            <Markdown :document={documentation.clone()} />
        </Column>
    </Column>
</view>
<rust>
use crate::components::demo_panel as DemoPanel;
use inrux::Style;
/// A keyed preview owns its values; sidebar and documentation layout own navigation only.
#[derive(Clone)]
pub struct Props {
    pub example: crate::catalogue::Example,
}

let usage: inrux::markdown::Markdown =
    inrux::markdown::Markdown::parse(&format!("```iru\n{}\n```", props.example.usage()));
let documentation: inrux::markdown::Markdown = inrux::markdown::Markdown::parse(&format!(
    "### Appearance and API\n\nUse classes for reusable styles and IDs for specific elements. Explicit Rust styles override stylesheet rules.\n\n### State and bindings\n\n{}\n\n- Theme and viewport changes preserve this example's state.\n- Switching components starts a fresh example.",
    props.example.description()
));
let value: String = "Inrux Workspace".into();
let notes: String = "First line\nA native multiline editor.\n".into();
let checked: bool = false;
let disabled: bool = false;
let count: u32 = 0;
</rust>
