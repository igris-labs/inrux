<view>
    <Box class="stack">
        <DemoPanel title="Cancellable work without blocking input">
            <Text text="Start a three-second task. Edit the name or increment while progress advances." class="muted" />
            <Input model:value={state.name} placeholder="Keep typing while the worker runs" class="input" />
            <Row :style={Style::new().wrap(true)} gap={8.0}>
                <Button :text={if state.busy { "Working..." } else { "Run background task" }} @click={start_task} :disabled={state.busy} :style={primary_style(state.busy).width(Size::Px(210.0))} />
                <Button width={Size::Px(140.0)} text="Cancel task" @click={cancel_task} :disabled={!state.busy} class="button" />
                <Button :text={format!("Independent count: {}", state.count)} @click={increment} class="button" />
            </Row>
            <Text :text={format!("Progress: {}% | Completed tasks: {}", state.progress.get(), state.completed)} class="body" />
            <Text :text={state.message.clone()} class="muted" />
            <Text text="Leaving this view disposes its state and cancels its owned work." class="muted" />
        </DemoPanel>
    </Box>
</view>
<rust>
use inrux::prelude::*;
use crate::components::demo_panel as DemoPanel;
use crate::features::background::{start_task, cancel_task, increment};
use crate::features::controls::primary_style;
#[derive(Clone)]
pub struct Props {}
#[derive(Clone)]
pub struct State { pub props: Props, pub name: String, pub busy: bool, pub completed: u32, pub progress: Signal<u32>, pub task: Option<TaskHandle>, pub message: String, pub count: u32 }
/// Each mount owns a new worker scope; navigation never revives completed state.
pub fn setup(props: Props) -> State { State { props, name: "Inrux Workspace".into(), busy: false, completed: 0, progress: Signal::new(0), task: None, message: "Ready. Background work runs in the bounded task pool.".into(), count: 0 } }
</rust>
