<view>
    <Row class="retained-counter">
        <Text :text={format!("{}: {}", props.label, counter.count.get())} width={Size::Px(110.0)} />
        <Input model:value={note} class="input" placeholder="This edit follows its keyed row" width={Size::Px(320.0)} />
        <Button text="Add one" @click={increment} class="button" />
    </Row>
</view>
<rust>
use crate::composables::use_counter::{Counter, use_counter};
use inrux::prelude::*;
/// Props are replaced without rebuilding the child's local state.
#[derive(Clone)]
pub struct Props {
    pub label: String,
}

let counter: Counter = use_counter();
let note: String = String::new();

/// Update this child through the root's bounded coordinator queue.
fn increment(state: &mut State, _: &Context<State>) {
    state.counter.count.update(|count| *count += 1);
}
</rust>
<style scoped>
.retained-counter {
  gap: 8px;
  padding: 8px;
  background: #edf3f0;
  border-radius: 6px;
}
</style>
