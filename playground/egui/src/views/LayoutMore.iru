<view>
    <Box class="stack">
        <DemoPanel title="Flex direction and retained input">
            <Row :style={Style::new().wrap(true)} gap={12.0}>
                <Button :text={direction_label} @click={toggle_direction} class="button" />
                <Text text="Edit the input, then change direction. Its value stays with the same control." class="muted" />
            </Row>
            <Flex :direction={direction} class="more-flex">
                <Input key="layout-note" model:value={note} placeholder="This edit survives direction changes" width={Size::Px(300.0)} class="input" />
                <Button :text={format!("Count: {}", count)} @click={increment} width={Size::Px(140.0)} class="button" />
            </Flex>
        </DemoPanel>
        <DemoPanel title="Grid columns and AspectRatio">
            <Row :style={Style::new().wrap(true)} gap={20.0}>
                <Column width={Size::Px(260.0)} gap={10.0}>
                    <Text text="Equal-width columns, automatic rows" class="body" />
                    <Button :text={columns_label} @click={toggle_columns} class="button" />
                    <Grid :columns={columns} class="uniform-grid">
                        <Text text="Alpha" class="grid-cell" />
                        <Text text="Beta" class="grid-cell" />
                        <Text text="Gamma" class="grid-cell" />
                        <Text text="Delta" class="grid-cell" />
                        <Text text="Epsilon" class="grid-cell" />
                        <Text text="Zeta" class="grid-cell" />
                    </Grid>
                </Column>
                <Column width={Size::Px(300.0)} gap={10.0}>
                    <Text text="Preferred width / height" class="body" />
                    <Button :text={ratio_label} @click={toggle_ratio} class="button" />
                    <AspectRatio :ratio={ratio} class="ratio-example">
                        <Center height={Size::Fill}>
                            <Text :text={preview_label} />
                        </Center>
                    </AspectRatio>
                </Column>
            </Row>
        </DemoPanel>
    </Box>
</view>
<rust>
use crate::components::demo_panel as DemoPanel;
use crate::features::layout_more::{increment, toggle_columns, toggle_direction, toggle_ratio};
use inrux::prelude::*;
#[derive(Clone)]
pub struct Props {}

let column: Signal<bool> = Signal::new(false);
let square: Signal<bool> = Signal::new(true);
let three_columns: Signal<bool> = Signal::new(false);
let direction_label_column = column.clone();
let direction_label: Computed<&'static str> = Computed::new(move || {
    if direction_label_column.get() {
        "Use row direction"
    } else {
        "Use column direction"
    }
});
let direction_column = column.clone();
let direction: Computed<FlexDirection> = Computed::new(move || {
    if direction_column.get() {
        FlexDirection::Column
    } else {
        FlexDirection::Row
    }
});
let columns_label_three_columns = three_columns.clone();
let columns_label: Computed<&'static str> = Computed::new(move || {
    if columns_label_three_columns.get() {
        "Use two columns"
    } else {
        "Use three columns"
    }
});
let columns_three_columns = three_columns.clone();
let columns: Computed<u16> =
    Computed::new(move || if columns_three_columns.get() { 3 } else { 2 });
let ratio_label_square = square.clone();
let ratio_label: Computed<&'static str> = Computed::new(move || {
    if ratio_label_square.get() {
        "Use landscape ratio"
    } else {
        "Use square ratio"
    }
});
let ratio_square = square.clone();
let ratio: Computed<f32> =
    Computed::new(move || if ratio_square.get() { 1.0 } else { 16.0 / 9.0 });
let preview_label_square = square.clone();
let preview_label: Computed<&'static str> = Computed::new(move || {
    if preview_label_square.get() {
        "1 : 1"
    } else {
        "16 : 9"
    }
});

let note: String = String::new();
let count: u32 = 0;
</rust>
<style scoped>
.more-flex { gap: 12px; padding: 8px; background: #ffffff; border-radius: 6px; }
.uniform-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.grid-cell { height: 30px; padding: 6px; font-size: 14px; background: #e4ebe7; border-radius: 4px; }
.ratio-example { width: 120px; aspect-ratio: 1; background: #e4ebe7; border-radius: 6px; }
</style>
