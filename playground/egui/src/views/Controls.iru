<view>
    <Box class="stack">
        <DemoPanel title="Input models and Button states">
            <Text text="Workspace name" class="body" />
            <Input model:value={name} @input={mark_dirty} placeholder="Enter a workspace name" :disabled={locked} class="input" />
            <Text :text={save_status} class="muted" />
            <Row :style={Style::new().wrap(true)} gap={8.0}>
                <Button text="Save changes" @click={save} :disabled={saved} :style={primary_style(saved.get())} />
                <Button text="Reset name" @click={reset} class="button" />
                <Button text="Clear name" @click={clear} class="button" />
                <Button text="Disabled button" @click={forbidden} :disabled={true} :style={primary_style(true)} />
            </Row>
            <Checkbox label="Disable the name input" model:checked={locked} class="body" />
        </DemoPanel>
        <DemoPanel title="Checkbox values and disabled admission">
            <Checkbox label="Enable notifications" model:checked={notifications} class="body" />
            <Checkbox label="Disable the checkbox below" model:checked={checkbox_locked} class="body" />
            <Checkbox label="Controlled choice" model:checked={choice} :disabled={checkbox_locked} class="body" />
            <Text :text={format!("Notifications: {} | Choice: {} | Disabled activations: {}", notifications, choice, forbidden)} class="muted" />
            <Text text="Try Tab, typing, selection, Space and Enter. Disabled controls reject interaction." class="muted" />
        </DemoPanel>
    </Box>
</view>
<rust>
use crate::components::demo_panel as DemoPanel;
use crate::features::controls::{clear, forbidden, mark_dirty, primary_style, reset, save};
use inrux::prelude::*;
#[derive(Clone)]
pub struct Props {}

let saved: Signal<bool> = Signal::new(true);
let save_status_saved = saved.clone();
let save_status: Computed<&'static str> = Computed::new(move || {
    if save_status_saved.get() {
        "All changes saved in memory."
    } else {
        "You have unsaved changes."
    }
});
let name: String = "Inrux Workspace".into();
let locked: bool = false;
let notifications: bool = false;
let checkbox_locked: bool = false;
let choice: bool = true;
let forbidden: u32 = 0;
</rust>
