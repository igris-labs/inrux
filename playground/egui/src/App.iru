<view>
    <ShowcaseLayout :engine={crate::engine::LABEL} :page={page} @navigate={navigate} :dark={theme.dark} @theme={crate::theme::toggle} :request={request} @top={crate::navigation::top} @end={crate::navigation::end}>
        <If condition={page.example().is_some()}>
            <ComponentPreview :example={page.example().unwrap_or(crate::catalogue::Example::Button)} :key={page.title()} />
        </If>
        <If condition={page == Page::Layout}><LayoutView /></If>
        <If condition={page == Page::Controls}><ControlsView /></If>
        <If condition={page == Page::Composition}><CompositionView /></If>
        <If condition={page == Page::Background}><BackgroundView /></If>
        <If condition={page == Page::LayoutMore}><LayoutMoreView /></If>
        <If condition={page == Page::Content}><ContentView /></If>
        <If condition={page == Page::Scrolling}><ScrollingView /></If>
        <If condition={page == Page::Engine}><EngineView /></If>
    </ShowcaseLayout>
</view>
<rust>
use crate::layouts::showcase_layout as ShowcaseLayout;
use crate::navigation::{Page, navigate};
use crate::views::component_preview as ComponentPreview;
use crate::views::{
    background as BackgroundView, composition as CompositionView, content as ContentView,
    controls as ControlsView, engine as EngineView, layout as LayoutView,
    layout_more as LayoutMoreView, scrolling as ScrollingView,
};
use inrux::prelude::*;

let page: Page = Page::Example(crate::catalogue::Example::Button);
let theme: crate::theme::Theme = crate::theme::Theme::new();
let request: ScrollRequest = ScrollRequest {
    revision: 0,
    offset: ScrollOffset::default(),
};

/// Provide a typed application token without global mutable state.
pub fn scope() -> Scope {
    Scope::default().provide(crate::features::composition::Accent(Color(29, 112, 98)))
}
</rust>
